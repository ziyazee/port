# Spring Boot Configuration
# Use dev for local compose MySQL, prod/aws for managed databases.
SPRING_PROFILES_ACTIVE=prod

# Database Configuration
# Any MySQL-compatible target can be used here: local, AWS RDS, Cloud SQL, etc.
SPRING_DATASOURCE_URL=jdbc:mysql://your-db-host:3306/porter?allowPublicKeyRetrieval=true&useSSL=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=your_db_username
SPRING_DATASOURCE_PASSWORD=your_db_password
SPRING_DATASOURCE_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver

# JPA Configuration
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# Optional local MySQL container settings.
# Used only with: docker compose -f docker-compose.yml -f docker-compose.local.yml up --build
MYSQL_DATABASE=porter
MYSQL_USER=porter
MYSQL_PASSWORD=porter
MYSQL_ROOT_PASSWORD=root
MYSQL_PORT=3307

# Application Ports
BACKEND_PORT=8081
FRONTEND_PORT=5174

# Document Storage
# Use local for development, gcs for Google Cloud Storage.
PORTER_DOCUMENT_STORAGE_PROVIDER=gcs
PORTER_GCS_BUCKET_NAME=your-gcs-bucket
PORTER_GCS_PROJECT_ID=your-gcp-project-id
PORTER_GCS_OBJECT_PREFIX=documents
PORTER_GCS_CREDENTIALS_PATH=/path/to/service-account.json

# For local runs outside GCP, point this to a service-account JSON file.
# In GCP runtimes, prefer Workload Identity / attached service account instead.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
